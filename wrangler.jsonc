// Cloudflare settings for the app. Secrets do NOT go in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "westward-property-care",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "westward-db",
      // From Cloudflare: Storage & Databases → D1 → westward-db (not a secret)
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The public address of the site (used to build login links)
    "BETTER_AUTH_URL": "https://westward-property-care.coopeisenman.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
